<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp">

    <!-- Thanh màu trạng thái bên trái -->
    <View
        android:id="@+id/viewStatusBar"
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@color/status_on_logistic"/>

    <!-- Mã đơn -->
    <TextView
        android:id="@+id/tvOrderID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="ORD-001"
        android:textColor="#1A237E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:maxLines="2"/>

    <!-- Ngày -->
    <TextView
        android:id="@+id/tvOrderDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="28/05/2024"
        android:textColor="#78909C"
        android:textSize="12sp"
        android:gravity="center"/>

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvOrderStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:text="Completed"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="5dp"
        android:background="@drawable/bg_status_pill"
        android:maxLines="1"/>

    <!-- Tổng tiền -->
    <TextView
        android:id="@+id/tvOrderTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:text="1,250,000 đ"
        android:textColor="#B71C1C"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="end"
        android:paddingEnd="16dp"/>

</LinearLayout>
