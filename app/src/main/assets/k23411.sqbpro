column index="8" value="187"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Tạm thời tắt kiểm tra ràng buộc khóa ngoại
PRAGMA foreign_keys = OFF;

-- 2. Xóa toàn bộ dữ liệu trong bảng Products
DELETE FROM Products;

-- 3. Thêm mới các sản phẩm có danh mục khớp với bảng Category
INSERT INTO Products (ProductID, ProductName, Category, Unit, Price, Stock, Status, Notes) VALUES
('P001', 'Mì tôm Hảo Hảo', 'Mì', 'Thùng', 120000.0, 50, 'Available', 'Vị tôm chua cay'),
('P002', 'Mì xào Indomie', 'Mì', 'Gói', 6000.0, 100, 'Available', 'Mì xào khô nhập khẩu'),

('P003', 'Cà chua Đà Lạt', 'Rau củ quả', 'Kg', 35000.0, 30, 'Available', 'Hàng tươi mới mỗi ngày'),
('P004', 'Bắp cải xanh', 'Rau củ quả', 'Bắp', 18000.0, 40, 'Available', 'Chuẩn VietGAP'),

('P005', 'Coca Cola 320ml', 'Nước uống có ga', 'Lon', 10000.0, 200, 'Available', 'Ngon hơn khi uống lạnh'),
('P006', 'Pepsi Không Calo', 'Nước uống có ga', 'Chai', 12000.0, 150, 'Available', 'Vị chanh thanh mát'),

('P007', 'Xoài cát Hòa Lộc', 'Trái cây', 'Kg', 65000.0, 25, 'Available', 'Trái cây chín ngọt tự nhiên'),
('P008', 'Táo Envy', 'Trái cây', 'Trái', 25000.0, 80, 'Available', 'Nhập khẩu New Zealand'),

('P009', 'Thịt ba chỉ heo', 'Thịt', 'Khay', 75000.0, 15, 'Available', 'Thịt tươi sạch trong ngày'),
('P010', 'Ba rọi bò Mỹ', 'Thịt', 'Hộp', 130000.0, 20, 'Available', 'Cấp đông bảo quản lạnh');

-- 4. Bật lại kiểm tra khóa ngoại để bảo vệ toàn vẹn dữ liệu
PRAGMA foreign_keys = ON;</sql><current_tab id="0"/></tab_sql></sqlb_project>
